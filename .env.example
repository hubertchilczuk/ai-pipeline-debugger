# ---------- App ----------
APP_ENV=development
LOG_LEVEL=INFO

# ---------- LLM Routing ----------
# Tryby: "cheap" (Ollama only), "accurate" (OpenAI only), "auto" (Ollama + fallback OpenAI)
LLM_MODE=auto
LLM_CONFIDENCE_THRESHOLD=0.65

# ---------- OpenAI ----------
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_S=30

# ---------- Ollama ----------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_S=60

# ---------- Vector DB (ChromaDB) ----------
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION=pipeline_incidents
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ---------- Ingestion ----------
AIRFLOW_BASE_URL=
SPARK_HISTORY_URL=

# ---------- Parser ----------
# When true, unstructured logs (no regex match) are sent to the LLM router for extraction.
PARSER_USE_LLM_FALLBACK=false

# ---------- API security ----------
# If set, requests must include header `X-API-Key: <value>`.
API_KEY=
# Per-client requests per minute (0 disables).
RATE_LIMIT_PER_MINUTE=60
# Comma-separated list. Set via JSON in env if needed; leave blank to disable CORS.
# CORS_ORIGINS=["http://localhost:8501"]

# ---------- OpenTelemetry ----------
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
